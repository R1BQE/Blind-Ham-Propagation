[Unit]
Description=Blind-Ham Propagation API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/blind-ham-propagation
EnvironmentFile=-/etc/blind-ham-propagation.env
ExecStart=/var/www/blind-ham-propagation/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/blind-ham-propagation /var/log/blind-ham-propagation /var/www/blind-ham-propagation/data

[Install]
WantedBy=multi-user.target
