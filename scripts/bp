#!/usr/bin/env bash
# Simple in-place updater for the existing Debian VDS installation.
set -Eeuo pipefail

ROOT="/var/www/html/blind-prop"
BRANCH="main"
SERVICE="blind-ham-propagation"
SERVICE_FILE="/etc/systemd/system/${SERVICE}.service"
APACHE_FILE="/etc/apache2/conf-available/blind-ham-propagation.conf"
HEALTH_URL="http://127.0.0.1:8765/api/v1/health"
STATE_DIR="/var/lib/blind-ham-propagation"
LAST_GOOD="${STATE_DIR}/last-good"
LOCK_FILE="/run/lock/blind-ham-propagation-update.lock"

say() { printf '[bp] %s\n' "$*"; }
die() { say "ОШИБКА: $*" >&2; exit 1; }

require_root() {
    [[ "$EUID" -eq 0 ]] || die "Команду нужно запускать от root."
}

require_installation() {
    [[ -d "${ROOT}/.git" ]] || die "Не найден Git-репозиторий: ${ROOT}"
    [[ -x "${ROOT}/.venv/bin/python" ]] || die "Не найдено виртуальное окружение: ${ROOT}/.venv"
    command -v git >/dev/null || die "Не установлен git."
    command -v curl >/dev/null || die "Не установлен curl."
    command -v flock >/dev/null || die "Не установлен flock."
    command -v systemctl >/dev/null || die "Не найден systemctl."
    command -v systemd-analyze >/dev/null || die "Не найден systemd-analyze."
    command -v apachectl >/dev/null || die "Не найден apachectl."
}

check_clean_checkout() {
    local status branch
    status="$(git -C "$ROOT" status --porcelain --untracked-files=all)" \
        || die "Не удалось проверить состояние Git."
    if [[ -n "$status" ]]; then
        printf '%s\n' "$status" >&2
        die "Рабочая копия содержит изменения или незатреканные файлы. Updater не будет их перезаписывать."
    fi
    branch="$(git -C "$ROOT" branch --show-current)" \
        || die "Не удалось определить текущую ветку."
    [[ "$branch" == "$BRANCH" ]] || die "Ожидается ветка ${BRANCH}, сейчас: ${branch:-detached HEAD}."
}

health_ok() {
    curl --silent --show-error --fail --max-time 5 "$HEALTH_URL" 2>/dev/null \
        | grep -Eq '"status"[[:space:]]*:[[:space:]]*"ok"'
}

wait_for_health() {
    local attempt
    for attempt in $(seq 1 25); do
        if systemctl is-active --quiet "$SERVICE" && health_ok; then
            return 0
        fi
        sleep 1
    done
    return 1
}

restore_config_file() {
    local live="$1" backup="$2"
    if [[ -f "$backup" ]]; then
        install -o root -g root -m 0644 "$backup" "$live"
    fi
}

apply_configs() {
    local commit="$1" work="$2"
    local unit_candidate="$work/unit.candidate"
    local apache_candidate="$work/apache.candidate"

    git -C "$ROOT" show "${commit}:deploy/systemd/blind-ham-propagation.service" > "$unit_candidate" \
        || { say "В коммите ${commit} нет systemd-шаблона."; return 1; }
    git -C "$ROOT" show "${commit}:deploy/apache/blind-ham-propagation.conf" > "$apache_candidate" \
        || { say "В коммите ${commit} нет Apache-шаблона."; return 1; }

    if ! cmp -s "$unit_candidate" "$SERVICE_FILE"; then
        [[ -f "$SERVICE_FILE" ]] || { say "Не найден действующий unit: ${SERVICE_FILE}"; return 1; }
        cp -a "$SERVICE_FILE" "$work/unit.before" || { say "Не удалось сохранить действующий systemd unit."; return 1; }
        touch "$work/unit.changed" || { say "Не удалось отметить изменяемый systemd unit для отката."; return 1; }
        install -o root -g root -m 0644 "$unit_candidate" "$SERVICE_FILE" || { say "Не удалось установить systemd unit."; return 1; }
        systemd-analyze verify "$SERVICE_FILE" || return 1
        systemctl daemon-reload || return 1
    fi

    if ! cmp -s "$apache_candidate" "$APACHE_FILE"; then
        [[ -f "$APACHE_FILE" ]] || { say "Не найден действующий Apache-файл: ${APACHE_FILE}"; return 1; }
        cp -a "$APACHE_FILE" "$work/apache.before" || { say "Не удалось сохранить действующую конфигурацию Apache."; return 1; }
        touch "$work/apache.changed" || { say "Не удалось отметить изменяемую конфигурацию Apache для отката."; return 1; }
        install -o root -g root -m 0644 "$apache_candidate" "$APACHE_FILE" || { say "Не удалось установить конфигурацию Apache."; return 1; }
        apachectl configtest || return 1
    fi
}

restore_configs() {
    local work="$1"
    local failed=0

    if [[ -f "$work/unit.changed" ]]; then
        if [[ ! -f "$work/unit.before" ]] || ! restore_config_file "$SERVICE_FILE" "$work/unit.before" || ! cmp -s "$work/unit.before" "$SERVICE_FILE"; then
            say "ОШИБКА: не удалось восстановить systemd unit."
            failed=1
        elif ! systemctl daemon-reload; then
            say "ОШИБКА: systemd не принял восстановленный unit."
            failed=1
        fi
    fi

    if [[ -f "$work/apache.changed" ]]; then
        if [[ ! -f "$work/apache.before" ]] || ! restore_config_file "$APACHE_FILE" "$work/apache.before" || ! cmp -s "$work/apache.before" "$APACHE_FILE"; then
            say "ОШИБКА: не удалось восстановить конфигурацию Apache."
            failed=1
        elif ! apachectl configtest; then
            say "ОШИБКА: восстановленная конфигурация Apache не прошла configtest."
            failed=1
        elif ! apachectl graceful; then
            say "ОШИБКА: Apache не принял восстановленную конфигурацию."
            failed=1
        fi
    fi

    return "$failed"
}

save_config_backups() {
    local work="$1"
    local stamp destination
    if [[ ! -f "$work/unit.changed" && ! -f "$work/apache.changed" ]]; then
        return 0
    fi
    stamp="$(date +%Y%m%d-%H%M%S-%N)"
    destination="${ROOT}/backups/config-${stamp}"
    install -d -o root -g root -m 0700 "$destination" || return 1
    if [[ -f "$work/unit.before" ]]; then
        install -o root -g root -m 0600 "$work/unit.before" "$destination/blind-ham-propagation.service" || return 1
    fi
    if [[ -f "$work/apache.before" ]]; then
        install -o root -g root -m 0600 "$work/apache.before" "$destination/blind-ham-propagation.conf" || return 1
    fi
    say "Старые конфигурации сохранены в ${destination}"
}

save_environment_snapshot() {
    local commit="$1"
    local destination="${STATE_DIR}/requirements-${commit}.txt"
    local temporary

    install -d -o root -g root -m 0750 "$STATE_DIR" || return 1
    temporary="$(mktemp "${destination}.tmp.XXXXXX")" || return 1
    "${ROOT}/.venv/bin/python" -m pip freeze --all > "$temporary" || {
        rm -f "$temporary"
        return 1
    }
    chmod 0600 "$temporary" || return 1
    mv -f "$temporary" "$destination" || return 1
}

restore_dependencies() {
    local commit="$1"
    local snapshot="${STATE_DIR}/requirements-${commit}.txt"

    if [[ -f "${ROOT}/requirements-vds.lock" ]]; then
        say "Восстанавливаю зависимости по lock-файлу версии ${commit:0:12}."
        "${ROOT}/.venv/bin/python" -m pip install -r "${ROOT}/requirements-vds.lock" || return 1
    elif [[ -s "$snapshot" ]]; then
        say "Для старой версии lock-файла нет; восстанавливаю сохранённый pip freeze."
        "${ROOT}/.venv/bin/python" -m pip install -r "$snapshot" || return 1
    else
        say "Нет lock-файла или сохранённого снимка зависимостей для ${commit}."
        return 1
    fi

    "${ROOT}/.venv/bin/python" -m pip check
}

install_dependencies_if_changed() {
    local from="$1" to="$2"
    if ! git -C "$ROOT" diff --quiet "$from" "$to" -- requirements-vds.lock; then
        if [[ -f "${ROOT}/requirements-vds.lock" ]]; then
            say "Изменился requirements-vds.lock — устанавливаю зафиксированные зависимости."
            "${ROOT}/.venv/bin/python" -m pip install -r "${ROOT}/requirements-vds.lock" || return 1
            "${ROOT}/.venv/bin/python" -m pip check
        else
            restore_dependencies "$to"
        fi
    else
        say "requirements-vds.lock не менялся — Python-зависимости не трогаю."
    fi
}

run_tests() {
    say "Запускаю тесты."
    (
        cd "$ROOT" || return 1
        "${ROOT}/.venv/bin/python" -m pytest tests
    )
}

restart_and_check() {
    say "Перезапускаю службу."
    systemctl restart "$SERVICE" || return 1
    wait_for_health
}

abort_update() {
    local previous="$1" work="$2" current="$3" reason="$4"
    if rollback_transaction "$previous" "$work" "$current"; then
        rm -rf "$work"
        die "$reason. Откат к предыдущей версии подтверждён."
    fi
    rm -rf "$work"
    die "КРИТИЧЕСКАЯ ОШИБКА: $reason. Автоматический откат НЕ подтверждён; требуется ручная диагностика."
}

install_launcher_link() {
    local launcher="/usr/local/sbin/bp"
    local temporary="${launcher}.new.${RANDOM}.${BASHPID}"

    # During the first transition the new updater is invoked as bp-bootstrap.
    # Replace the legacy dispatcher only after the new release passed all checks.
    [[ "$0" == "/usr/local/sbin/bp-bootstrap" ]] || return 0
    [[ -x "${ROOT}/scripts/bp" ]] || {
        say "ВНИМАНИЕ: новый scripts/bp не найден; старый launcher оставлен без изменений."
        return 1
    }

    rm -f "$temporary"
    ln -s "${ROOT}/scripts/bp" "$temporary" || return 1
    mv -Tf "$temporary" "$launcher" || {
        rm -f "$temporary"
        return 1
    }
    say "Команда /usr/local/sbin/bp переключена на scripts/bp."
}

rollback_transaction() {
    local previous="$1" work="$2" current="$3"
    local failed=0 actual

    say "Откатываю исходный код к ${previous}."
    if ! git -C "$ROOT" reset --hard "$previous"; then
        say "КРИТИЧЕСКАЯ ОШИБКА: git reset --hard не выполнился."
        return 1
    fi

    actual="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null)" || actual=""
    if [[ "$actual" != "$previous" ]]; then
        say "КРИТИЧЕСКАЯ ОШИБКА: HEAD после reset не совпадает с целевым коммитом."
        return 1
    fi

    restore_configs "$work" || failed=1

    if ! git -C "$ROOT" diff --quiet "$current" "$previous" -- requirements-vds.lock; then
        say "Возвращаю зависимости предыдущей версии."
        restore_dependencies "$previous" || failed=1
    fi

    systemctl restart "$SERVICE" || failed=1
    if (( failed == 0 )) && wait_for_health; then
        actual="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null)" || actual=""
        if [[ "$actual" == "$previous" ]]; then
            say "Откат подтверждён: код, конфигурация, зависимости и локальный health проверены."
            return 0
        fi
    fi

    say "КРИТИЧЕСКАЯ ОШИБКА: откат НЕ подтверждён. Не считай сервер восстановленным."
    say "Проверь: git -C $ROOT rev-parse HEAD; pip check; systemctl status $SERVICE; journalctl -u $SERVICE."
    return 1
}

do_update() {
    local work previous current
    work="$(mktemp -d /tmp/bp-update.XXXXXX)"
    previous="$(git -C "$ROOT" rev-parse HEAD)"
    save_environment_snapshot "$previous" || {
        rm -rf "$work"
        die "Не удалось сохранить снимок текущих Python-зависимостей."
    }

    say "Получаю изменения из origin/${BRANCH}."
    if ! git -C "$ROOT" pull --ff-only origin "$BRANCH"; then
        rm -rf "$work"
        die "git pull не выполнен. Рабочая версия не изменена."
    fi
    current="$(git -C "$ROOT" rev-parse HEAD)" || abort_update "$previous" "$work" "$previous" "Не удалось определить коммит после git pull"
    if [[ "$current" == "$previous" ]]; then
        rm -rf "$work"
        say "Уже установлена последняя версия: ${current:0:12}"
        return 0
    fi

    if ! install_dependencies_if_changed "$previous" "$current"; then
        abort_update "$previous" "$work" "$current" "Не удалось обновить Python-зависимости"
    fi

    if ! save_environment_snapshot "$current"; then
        abort_update "$previous" "$work" "$current" "Не удалось сохранить снимок зависимостей новой версии"
    fi

    if ! run_tests; then
        abort_update "$previous" "$work" "$current" "Тесты не прошли"
    fi

    if ! apply_configs "$current" "$work"; then
        abort_update "$previous" "$work" "$current" "Не удалось применить или проверить конфигурацию"
    fi

    if ! save_config_backups "$work"; then
        abort_update "$previous" "$work" "$current" "Не удалось сохранить резервные копии конфигурации"
    fi

    if [[ -f "$work/apache.changed" ]] && ! apachectl graceful; then
        abort_update "$previous" "$work" "$current" "Apache не удалось перезагрузить"
    fi

    if ! restart_and_check; then
        abort_update "$previous" "$work" "$current" "Служба не прошла health-проверку"
    fi

    if ! install -d -o root -g root -m 0750 "$STATE_DIR"; then
        abort_update "$previous" "$work" "$current" "Не удалось подготовить каталог состояния для last-good"
    fi
    if ! printf '%s\n' "$previous" > "${LAST_GOOD}.tmp" ||
       ! chmod 0600 "${LAST_GOOD}.tmp" ||
       ! mv -f "${LAST_GOOD}.tmp" "$LAST_GOOD"; then
        rm -f "${LAST_GOOD}.tmp"
        abort_update "$previous" "$work" "$current" "Не удалось сохранить commit для ручного отката"
    fi
    if ! install_launcher_link; then
        say "ВНИМАНИЕ: приложение обновлено, но автоматическая замена launcher не удалась."
        say "Старый /usr/local/sbin/bp не тронут; используй /usr/local/sbin/bp-bootstrap после ручной проверки."
    fi
    rm -rf "$work"

    say "Обновление завершено: ${previous:0:12} -> ${current:0:12}"
    if curl --silent --show-error --fail --max-time 10 https://blind-ham.ru/prop/api/v1/health >/dev/null; then
        say "Публичный health endpoint отвечает."
    else
        say "Публичный health endpoint сейчас не ответил; локальная проверка успешна."
    fi
}

do_rollback() {
    local work current target
    [[ -s "$LAST_GOOD" ]] || die "Нет сохранённой предыдущей версии для отката."
    target="$(cat "$LAST_GOOD")"
    [[ "$target" =~ ^[0-9a-f]{40}$ ]] || die "Файл last-good содержит некорректный commit SHA."
    git -C "$ROOT" cat-file -e "${target}^{commit}" 2>/dev/null || die "Коммит для отката отсутствует в локальном Git."
    current="$(git -C "$ROOT" rev-parse HEAD)"
    [[ "$current" != "$target" ]] || die "Уже установлена версия, указанная для отката."

    work="$(mktemp -d /tmp/bp-rollback.XXXXXX)"
    if ! git -C "$ROOT" reset --hard "$target"; then
        rm -rf "$work"
        die "Не удалось переключить код."
    fi
    if ! install_dependencies_if_changed "$current" "$target" || ! run_tests || ! apply_configs "$target" "$work"; then
        say "Откат не прошёл проверку. Возвращаю исходную версию ${current:0:12}."
        if rollback_transaction "$current" "$work" "$target"; then
            rm -rf "$work"
            die "Откат не прошёл проверку; исходная версия ${current:0:12} восстановлена и проверена."
        fi
        rm -rf "$work"
        die "КРИТИЧЕСКАЯ ОШИБКА: не удалось подтвердить восстановление исходной версии ${current:0:12}."
    fi
    if ! save_config_backups "$work"; then
        say "Не удалось сохранить копии конфигурации; возвращаю исходную версию."
        if rollback_transaction "$current" "$work" "$target"; then
            rm -rf "$work"
            die "Копии конфигурации не сохранены; исходная версия восстановлена и проверена."
        fi
        rm -rf "$work"
        die "КРИТИЧЕСКАЯ ОШИБКА: исходная версия не подтверждена после ошибки резервного копирования."
    fi
    if [[ -f "$work/apache.changed" ]] && ! apachectl graceful; then
        say "Apache не перезагрузился; возвращаю исходную версию."
        if rollback_transaction "$current" "$work" "$target"; then
            rm -rf "$work"
            die "Apache не перезагрузился; исходная версия восстановлена и проверена."
        fi
        rm -rf "$work"
        die "КРИТИЧЕСКАЯ ОШИБКА: исходная версия не подтверждена после ошибки Apache."
    fi
    if ! restart_and_check; then
        say "Новая версия не прошла health check; возвращаю исходную версию."
        if rollback_transaction "$current" "$work" "$target"; then
            rm -rf "$work"
            die "Новая версия не прошла health check; исходная версия восстановлена и проверена."
        fi
        rm -rf "$work"
        die "КРИТИЧЕСКАЯ ОШИБКА: исходная версия не подтверждена после ошибки health check."
    fi

    if ! printf '%s\n' "$current" > "${LAST_GOOD}.tmp" ||
       ! chmod 0600 "${LAST_GOOD}.tmp" ||
       ! mv -f "${LAST_GOOD}.tmp" "$LAST_GOOD"; then
        rm -f "${LAST_GOOD}.tmp"
        rm -rf "$work"
        die "Откат выполнен и проверен, но не удалось обновить last-good. Проверь состояние вручную."
    fi
    rm -rf "$work"
    say "Откат завершён: ${current:0:12} -> ${target:0:12}"
}

do_status() {
    local commit branch
    commit="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"
    branch="$(git -C "$ROOT" branch --show-current 2>/dev/null || echo unknown)"
    printf 'Проект: %s\nВетка: %s\nКоммит: %s\nСлужба: ' "$ROOT" "$branch" "$commit"
    systemctl is-active "$SERVICE" 2>/dev/null || true
    printf 'Локальный health: '
    if health_ok; then echo OK; else echo FAIL; fi
    printf 'Предыдущая версия для отката: '
    if [[ -s "$LAST_GOOD" ]]; then cat "$LAST_GOOD"; else echo 'не задана'; fi
}

main() {
    require_root
    require_installation
    install -d -m 0755 /run/lock
    exec 9>"$LOCK_FILE"
    flock -n 9 || die "Другая операция bp уже выполняется."

    case "${1:-status}" in
        update)
            check_clean_checkout
            do_update
            ;;
        rollback)
            check_clean_checkout
            do_rollback
            ;;
        status)
            do_status
            ;;
        *)
            echo "Использование: bp {update|rollback|status}" >&2
            exit 2
            ;;
    esac
}

main "$@"
